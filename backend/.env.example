# Variables de entorno del backend.
# Copiá este archivo como .env dentro de la carpeta backend/ y completá los valores.

# Puerto donde escuchará el servidor (por defecto: 3001)
PORT=3001

# URL del frontend (para configurar CORS)
FRONTEND_URL=http://localhost:5173

# Credenciales de Supabase — Dashboard → Project Settings → API
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Usar la Service Role Key (secreta, nunca exponerla al cliente)
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>
